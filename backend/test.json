        {
          "name": "Create New Incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Major Flash Flood & Highway Submersion\",\n  \"type\": \"FLOOD\",\n  \"description\": \"Rapid storm water accumulation reaching 1.2m depth on Highway 101 underpass. 4 commuter sedans disabled, occupants on vehicle roofs.\",\n  \"location\": {\n    \"latitude\": 37.7682,\n    \"longitude\": -122.4071,\n    \"address\": \"Hwy 101 Southbound at Cesar Chavez Interchange\"\n  },\n  \"severity\": \"HIGH\",\n  \"priority\": \"P1\",\n  \"source\": \"SENSOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Incident generated with custom ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.incident).to.have.property(\"incidentId\");",
                  "    pm.expect(json.data.incident.incidentId).to.match(/^ER-\\d+/);",
                  "    pm.expect(json.data.incident.location.geometry.coordinates).to.have.lengthOf(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
