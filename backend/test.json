              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns list of incidents with pagination\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.incidents).to.be.an(\"array\");",
                  "    pm.expect(json.data.incidents.length).to.be.at.least(1);",
                  "    pm.expect(json.data.pagination).to.have.property(\"total\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter Incidents (Status & Severity)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents?status=RESPONDING&severity=CRITICAL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "RESPONDING"
                },
                {
                  "key": "severity",
                  "value": "CRITICAL"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned items match filter\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.incidents.forEach(function(inc) {",
                  "        pm.expect(inc.status).to.eql(\"RESPONDING\");",
                  "        pm.expect(inc.severity).to.eql(\"CRITICAL\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
