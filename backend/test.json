{
  "info": {
    "_postman_id": "ps9-backend-phase1-phase2-collection",
    "name": "PS-9 Emergency Response Platform - Backend Test Suite",
    "description": "Postman test suite for PS-9: Intelligent Emergency Response & Resource Coordination Platform.\n\nCovers Phase 1 (Backend Foundation) and Phase 2 (Database Architecture) with automated pm.test assertions, sample request payloads, query parameter tests, and authentication token chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health & System",
      "item": [
        {
          "name": "Health Check (Operational Status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifies server uptime, database connection state, and API availability."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Database is connected\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.database).to.eql(\"connected\");",
                  "    pm.expect(json.uptime).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "System Status & Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "status"
              ]
            },
            "description": "Checks Node.js runtime metrics, memory heap usage, Mongoose version, and uptime."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains API and Database metadata\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.api.status).to.eql(\"ONLINE\");",
                  "    pm.expect(json.data.database.status).to.eql(\"CONNECTED\");",
                  "    pm.expect(json.data.memory).to.have.property(\"heapUsedMb\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Login (Admin User - Auto-saves Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@emergency.ps9.gov\",\n  \"password\": \"Emergency@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in with seeded Administrator account. The test script automatically saves the returned JWT into the collection variable 'authToken'."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (Login Successful)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns valid JWT token and user info\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property(\"token\");",
                  "    pm.expect(json.data.user.role).to.eql(\"ADMIN\");",
                  "    pm.expect(json.data.user).to.not.have.property(\"password\");",
                  "    ",
                  "    // Save token to collection variable for subsequent authenticated requests",
                  "    pm.collectionVariables.set(\"authToken\", json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Operator User)",
          "request": {
            "method": "POST",
