        {
          "name": "Register New Responder User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test First Responder\",\n  \"email\": \"test.responder.{{$timestamp}}@emergency.ps9.gov\",\n  \"password\": \"ResponderPass@2026\",\n  \"role\": \"FIELD_COORDINATOR\",\n  \"department\": \"Urban Search & Rapid Rescue\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email using timestamp",
                  "var timestamp = new Date().getTime();",
                  "pm.environment.set(\"dynamicEmail\", \"responder.\" + timestamp + \"@ps9.gov\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User registered successfully\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.user.email).to.include(\"emergency.ps9.gov\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
